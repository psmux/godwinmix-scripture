{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "description": "bible or song.",
      "enum": [
        "bible",
        "song"
      ]
    },
    "id": {
      "type": "string",
      "description": "A style id from styles."
    },
    "overrides": {
      "type": "object",
      "description": "font, scale, color, accent, box, shadow, align, margin."
    }
  },
  "required": [
    "kind"
  ],
  "additionalProperties": false
}
